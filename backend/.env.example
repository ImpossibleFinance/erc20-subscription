# --- chain ---
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
CONTRACT_ADDR=0x0000000000000000000000000000000000000000
TOKEN_ADDR=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Hex-encoded operator private key (no 0x). Hot key used to sign charge() /
# deactivate() calls. Generate a dedicated EOA — do not reuse the owner key.
OPERATOR_KEY_HEX=

# --- storage ---
REDIS_URL=redis://localhost:6379/0

# --- scheduler ---
TICK_INTERVAL=60s

# After a successful pull, if the user's remaining USDC allowance covers
# fewer than this many additional periods, emit a `subscription.allowance_low`
# webhook. 0 disables the check. Default: 2.
ALLOWANCE_LOW_MONTHS=2

# --- operator gas monitoring ---
# Emit an `operator.gas_low` webhook when the operator EOA's ETH balance
# won't cover at least this many more months of pulls at current gas prices.
# The threshold is computed dynamically from the live sub count + chain head;
# no static wei value to keep tuned as the user base grows. 0 disables.
OPERATOR_GAS_BUFFER_MONTHS=1
# How often to re-fire the gas-low webhook while the balance stays low.
# Default: 6h.
OPERATOR_GAS_WARN_INTERVAL=6h

# --- webhooks ---
# Optional. If unset, webhook events are logged only.
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- http ---
LISTEN_ADDR=:8080
# Required: bearer token for /admin/* endpoints. 32+ random bytes recommended.
ADMIN_TOKEN=
